<link rel="stylesheet" href="/css/applications.css?v=20260922">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'applications' }) %>
  <main class="admin-content">
    <header class="admin-page-header">
      <div><p class="admin-eyebrow">Family connections</p><h1>Applications</h1><p class="admin-subtitle">A thoughtful home for every conversation. Review, reply, and plan your next step.</p></div>
      <a class="btn-secondary" href="/admin/applications?followUp=due">Due for follow-up <span class="inbox-count"><%= counts.due %></span></a>
    </header>
    <% if (success) { %><div class="admin-alert admin-alert-success" role="status"><%= success %></div><% } %>
    <% if (error) { %><div class="admin-alert admin-alert-error" role="alert"><%= error %></div><% } %>
    <% const urlFor = (updates = {}) => '/admin/applications?' + new URLSearchParams({ ...filters, page: '1', ...updates }).toString(); %>
    <nav class="admin-filter-tabs" aria-label="Application status">
      <% [['', 'All families', counts.all], ['Pending', 'To review', counts.Pending], ['Approved', 'Approved', counts.Approved], ['Sold', 'Completed', counts.Sold], ['Rejected', 'Declined', counts.Rejected]].forEach(([value,label,count]) => { %>
        <a class="admin-filter-tab <%= filters.status === value ? 'active' : '' %>" href="<%= urlFor({status:value}) %>" <%- filters.status === value ? 'aria-current="page"' : '' %>><%= label %> <span class="inbox-count"><%= count %></span></a>
      <% }) %>
    </nav>
    <form class="admin-toolbar inbox-search" method="get" action="/admin/applications" role="search">
      <div class="inbox-search-field"><label for="application-search">Find a family or puppy</label><input class="admin-search" id="application-search" type="search" name="q" value="<%= filters.q %>" placeholder="Name, email, puppy, or tracking code" maxlength="120"></div>
      <input type="hidden" name="status" value="<%= filters.status %>"><input type="hidden" name="followUp" value="<%= filters.followUp %>">
      <button type="submit" class="btn-primary">Search</button>
      <% if (filters.q || filters.status || filters.followUp) { %><a href="/admin/applications" class="btn-secondary">Clear filters</a><% } %>
    </form>
    <div class="admin-section-title"><p class="admin-muted"><%= total %> <%= total === 1 ? 'application' : 'applications' %><%= filters.followUp ? ' due for follow-up' : '' %></p><span class="admin-muted">Newest first</span></div>
    <% if (!applications.length) { %>
      <section class="admin-empty-state"><strong><%= counts.all ? 'No families match these filters.' : 'Your next chapter starts here.' %></strong><p><%= counts.all ? 'Try another name or clear the filters to see every application.' : 'When a family applies for a puppy, their application will appear here ready for your review.' %></p><a class="btn-secondary" href="<%= counts.all ? '/admin/applications' : '/admin/puppies' %>"><%= counts.all ? 'View all applications' : 'Review puppy listings' %></a></section>
    <% } else { %>
      <div class="inbox-list">
      <% applications.forEach(app => { const lastEmail = (app.activity || []).filter(e => e.type === 'email' && e.status === 'sent').pop(); %>
        <article class="inbox-card">
          <div class="family-avatar" aria-hidden="true"><%= (app.name || 'F').slice(0,1).toUpperCase() %></div>
          <div class="inbox-family"><a class="inbox-name" href="/admin/applications/<%= encodeURIComponent(app.id) %>"><%= app.name || 'Applicant' %></a><p><%= app.puppyName %> <span aria-hidden="true">·</span> <%= app.email %></p><small>Applied <%= app.createdAt ? new Date(app.createdAt).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : 'recently' %><%= lastEmail ? ' · Replied ' + new Date(lastEmail.createdAt).toLocaleDateString('en-US', { month:'short', day:'numeric' }) : ' · No reply recorded' %></small></div>
          <div class="inbox-status"><span class="status-pill <%= statusClass(app.status) %>"><%= app.status === 'Sold' ? 'Completed' : app.status === 'Rejected' ? 'Declined' : app.status %></span><% if (app.followUpDate) { %><small class="<%= app.followUpDate <= today ? 'follow-up-due' : '' %>">Follow up <%= app.followUpDate %></small><% } %></div>
          <a class="btn-secondary" href="/admin/applications/<%= encodeURIComponent(app.id) %>">Review & reply <span aria-hidden="true">→</span></a>
        </article>
      <% }) %>
      </div>
      <% if (pageCount > 1) { %><nav class="inbox-pagination" aria-label="Application pages"><% if (page > 1) { %><a class="btn-secondary" href="<%= urlFor({page:String(page-1)}) %>">Previous</a><% } %><span>Page <%= page %> of <%= pageCount %></span><% if (page < pageCount) { %><a class="btn-secondary" href="<%= urlFor({page:String(page+1)}) %>">Next</a><% } %></nav><% } %>
    <% } %>
  </main>
</div>
