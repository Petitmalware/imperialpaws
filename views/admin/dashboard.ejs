<%
  const actionNotifications = notifications.filter(item => item.href !== "/admin/settings");
  const setupNotifications = notifications.filter(item => item.href === "/admin/settings");
  const pendingCount = stats.pendingApplications || 0;
%>
<div class="admin-shell">
  <%- include("../partials/admin-sidebar", { active: "dashboard" }) %>
  <main class="admin-content" id="admin-main-content">
    <header class="admin-page-header">
      <div><p class="admin-eyebrow">Your breeder workspace</p><h1>A little care. A new beginning.</h1><p class="admin-subtitle">Welcome back. Here’s what’s happening with your puppies and their future families.</p></div>
      <a href="/admin/puppies/add" class="admin-link-button"><span aria-hidden="true">+</span> Add a puppy</a>
    </header>
    <section class="admin-welcome-banner" aria-labelledby="today-title">
      <div class="admin-welcome-copy">
        <span class="admin-banner-label">A good place to start</span>
        <h2 id="today-title"><%= pendingCount ? `${pendingCount} ${pendingCount === 1 ? 'family is' : 'families are'} waiting to hear from you.` : 'Every great match starts with a conversation.' %></h2>
        <p><%= pendingCount ? 'Open an application to review the details, write a personal reply, and choose the next step.' : 'Keep your puppy profiles up to date and give each new family a warm welcome.' %></p>
        <a href="<%= pendingCount ? '/admin/applications?status=Pending' : '/admin/puppies' %>" class="admin-banner-link"><%= pendingCount ? 'Review applications' : 'Manage puppy profiles' %> <span aria-hidden="true">↗</span></a>
      </div>
      <svg class="admin-banner-paw" viewBox="0 0 120 120" fill="currentColor" aria-hidden="true"><ellipse cx="27" cy="41" rx="11" ry="17" transform="rotate(-28 27 41)"/><ellipse cx="48" cy="24" rx="11" ry="17" transform="rotate(-12 48 24)"/><ellipse cx="73" cy="24" rx="11" ry="17" transform="rotate(12 73 24)"/><ellipse cx="94" cy="41" rx="11" ry="17" transform="rotate(28 94 41)"/><path d="M28 84c0-17 22-39 32-39s32 22 32 39c0 27-20 16-32 16S28 111 28 84z"/></svg>
    </section>
    <section class="admin-grid four admin-section-gap" aria-label="Adoption overview">
      <a href="/admin/applications?status=Pending" class="metric-card metric-card-link"><span>Awaiting review <span class="metric-arrow" aria-hidden="true">↗</span></span><strong><%= stats.pendingApplications %></strong><small><%= stats.applications %> total applications</small></a>
      <a href="/admin/puppies" class="metric-card metric-card-link"><span>Available puppies <span class="metric-arrow" aria-hidden="true">↗</span></span><strong><%= stats.availablePuppies %></strong><small><%= stats.reservedPuppies %> reserved · <%= stats.soldPuppies %> placed</small></a>
      <a href="/admin/invoices" class="metric-card metric-card-link"><span>Awaiting payment <span class="metric-arrow" aria-hidden="true">↗</span></span><strong><%= stats.unpaidInvoices %></strong><small><%= stats.overdueInvoices ? `${stats.overdueInvoices} past the due date` : 'No overdue invoices' %></small></a>
      <a href="/admin/testimonials" class="metric-card metric-card-link"><span>Family reviews <span class="metric-arrow" aria-hidden="true">↗</span></span><strong><%= stats.pendingTestimonials %></strong><small>Waiting for your approval</small></a>
    </section>
    <section class="admin-quick-actions admin-section-gap" aria-label="Quick actions"><span class="admin-quick-label">Quick actions</span><a href="/admin/applications">Review applications <span aria-hidden="true">→</span></a><a href="/admin/invoices/select-application">Create an invoice <span aria-hidden="true">→</span></a><a href="/admin/contracts">Prepare an agreement <span aria-hidden="true">→</span></a></section>
    <section class="admin-grid two admin-section-gap">
      <div class="admin-panel">
        <div class="admin-section-title"><div><p class="admin-eyebrow">Next steps</p><h2>Your attention list</h2></div><span class="admin-count"><%= actionNotifications.length %></span></div>
        <% if (!actionNotifications.length) { %>
          <div class="admin-empty-state admin-empty-inline"><span class="admin-empty-icon" aria-hidden="true">✓</span><strong>You’re all caught up.</strong><p>New applications and adoption follow-ups will appear here.</p></div>
        <% } else { %>
          <ul class="notification-list"><% actionNotifications.forEach(notification => { %><li class="notification-card <%= notification.tone %>"><div><strong><%= notification.title %></strong><p><%= notification.detail %></p></div><a href="<%= notification.href %>" class="admin-text-link"><%= notification.action %> <span aria-hidden="true">→</span></a></li><% }) %></ul>
        <% } %>
      </div>
      <div class="admin-panel">
        <div class="admin-section-title"><div><p class="admin-eyebrow">Meet your families</p><h2>Recent applications</h2></div><a href="/admin/applications" class="admin-text-link">View all <span aria-hidden="true">→</span></a></div>
        <% if (!recentApplications.length) { %>
          <div class="admin-empty-state admin-empty-inline"><strong>Your next match starts here.</strong><p>When a family applies, you can review their details and reply from your workspace.</p><a class="btn-secondary" href="/admin/puppies">Review your listings</a></div>
        <% } else { %>
          <ul class="activity-list"><% recentApplications.forEach(application => { %><li><a class="activity-item activity-link" href="/admin/applications/<%= encodeURIComponent(application.id) %>"><span class="admin-avatar light" aria-hidden="true"><%= (application.name || "F").slice(0, 1).toUpperCase() %></span><span class="activity-main"><strong><%= application.name || "Applicant" %></strong><small>Interested in <%= application.puppyName %></small></span><span class="status-pill <%= statusClass(application.status) %>"><%= application.status || "Pending" %></span><span class="activity-arrow" aria-hidden="true">›</span></a></li><% }) %></ul>
        <% } %>
      </div>
    </section>
    <section class="admin-grid two admin-section-gap">
      <div class="admin-panel">
        <div class="admin-section-title"><div><p class="admin-eyebrow">Adoption paperwork</p><h2>Payment follow-ups</h2></div><a href="/admin/invoices" class="admin-text-link">View invoices <span aria-hidden="true">→</span></a></div>
        <% if (!invoiceFollowUps.length) { %><p class="admin-empty">No unpaid invoices to follow up on. You can prepare a new invoice from an approved application.</p>
        <% } else { %>
          <ul class="activity-list"><% invoiceFollowUps.forEach(invoice => { %><li class="activity-item"><div class="activity-main"><strong><%= invoice.adoptingParent && invoice.adoptingParent.name ? invoice.adoptingParent.name : "Adopting family" %></strong><small><%= invoice.invoiceNumber %><% if (invoice.dueDate) { %> · Due <%= invoice.dueDate %><% } %></small></div><a href="/admin/invoices/view/<%= encodeURIComponent(invoice.invoiceNumber) %>" class="btn-small">Open invoice</a></li><% }) %></ul>
        <% } %>
      </div>
      <div class="admin-panel">
        <div class="admin-section-title"><div><p class="admin-eyebrow">Ready to meet the world</p><h2>Puppy profiles</h2></div><a href="/admin/puppies" class="admin-text-link">Manage <span aria-hidden="true">→</span></a></div>
        <% if (!puppyCareList.length) { %><p class="admin-empty"><%= (stats.availablePuppies + stats.reservedPuppies + stats.soldPuppies) ? 'Every puppy profile has a photo. Keep galleries and availability up to date so families know who is ready for a home.' : 'Add your first puppy profile with photos, a little personality, and the information families need.' %></p><a href="/admin/puppies/add" class="btn-secondary">Add a puppy</a>
        <% } else { %><ul class="activity-list"><% puppyCareList.forEach(puppy => { %><li class="activity-item"><div class="activity-main"><strong><%= puppy.name %></strong><small>A photo will help families get to know this puppy.</small></div><a href="/admin/puppies/images?id=<%= encodeURIComponent(puppy.id) %>" class="btn-small">Add photos</a></li><% }) %></ul><% } %>
      </div>
    </section>
    <% if (setupNotifications.length) { %><details class="admin-system-status admin-section-gap"><summary>Website setup <span class="admin-count"><%= setupNotifications.length %></span><span class="admin-muted">Check your configuration</span></summary><ul class="notification-list"><% setupNotifications.forEach(notification => { %><li class="notification-card <%= notification.tone %>"><strong><%= notification.title %></strong><p><%= notification.detail %></p><a href="<%= notification.href %>" class="admin-text-link"><%= notification.action %> <span aria-hidden="true">→</span></a></li><% }) %></ul></details><% } %>
    <p class="admin-workspace-footer">Thoughtful care, from the first hello to the journey home.</p>
  </main>
</div>
