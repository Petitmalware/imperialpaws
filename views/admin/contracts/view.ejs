<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title><%= contract.title %>
</title>
<style>
*{box-sizing:border-box}body{margin:0;color:#24312f;background:#eaece8;font:14px Arial,sans-serif}
.toolbar{padding:18px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;background:#fff;border-bottom:1px solid #ccc}button,.toolbar a{padding:10px 14px;border:1px solid #cbd2cd;border-radius:5px;background:#fff;color:#234638;text-decoration:none;cursor:pointer}button.primary{background:#234638;color:#fff}form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}input{padding:9px;border:1px solid #aab7ad;border-radius:4px}
.notice{text-align:center;padding:12px;margin:0}
.paper-scroll{overflow:auto;padding:24px}
.contract-page{width:7.5in;height:9.9in;margin:auto;background:#fff;box-shadow:0 8px 40px #24312f18;position:relative}
.contract-content{position:absolute;top:0;left:0;width:7.5in;padding:24px 30px;transform-origin:top left;overflow-wrap:anywhere}header{border-bottom:2px solid #234638;padding-bottom:14px;margin-bottom:16px}
.eyebrow{text-transform:uppercase;letter-spacing:2px;font-size:9px;color:#67796b;margin:0 0 8px}
.brand{font:bold 20px Georgia,serif;margin:0 0 9px}h1{font:normal 26px Georgia,serif;margin:0}
.details{display:grid;grid-template-columns:1fr 1fr;gap:12px;background:#f3f5f1;border:1px solid #d9dfd8;padding:12px;margin-bottom:16px}
.details span{display:block;text-transform:uppercase;font-size:9px;letter-spacing:1px;margin-bottom:5px;color:#5a6a5b}
.details strong{font-size:12px}
.contract-body{white-space:pre-wrap;font:10.5pt/1.45 Georgia,serif;color:#202923}
.signature-block{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:26px;font-size:11px}
.signature-block strong{display:block;margin-bottom:6px}
.signature{border-bottom:1px solid #58695d;height:34px;margin-bottom:5px}
.date{margin-top:16px}footer{margin-top:20px;padding-top:8px;border-top:1px solid #d9dfd8;display:flex;justify-content:space-between;font-size:9px;color:#5a6a5b}
@page{size:letter portrait;margin:0.5in}
@media print{html,body{margin:0;padding:0;background:white}
.no-print{display:none!important}
.paper-scroll{padding:0;overflow:visible}
.contract-page{margin:0;box-shadow:none;break-inside:avoid}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body>
<div class="toolbar no-print">
<button class="primary" id="printButton" type="button">Print / Save PDF</button>
<a href="/admin/contracts/<%= encodeURIComponent(contract.id) %>/edit">Edit agreement details</a>
<a href="/admin/contracts">Back</a>
<form method="GET">
<label for="buyer">Adopting parent</label>
<input id="buyer" name="buyer" value="<%= buyerName %>" maxlength="160">
<button>Apply name</button>
</form>
</div>
<form class="toolbar no-print" method="POST" action="/admin/contracts/<%= encodeURIComponent(contract.id) %>/email">
<input type="hidden" name="buyerName" value="<%= buyerName %>">
<label for="buyerEmail">Adopter email</label>
<input id="buyerEmail" type="email" name="buyerEmail" required>
<button>Email agreement</button>
</form>
<p class="notice no-print" id="fitStatus" role="status">One-page Letter agreement. Turn off browser headers and footers when printing.</p>
<div class="paper-scroll">
<article class="contract-page">
<div class="contract-content" id="content">
<header>
<p class="eyebrow">Pet adoption &amp; transfer agreement</p>
<p class="brand"><%= contract.headerName === undefined ? 'ImperialPaws Pekingese' : contract.headerName %>
</p>
<h1><%= contract.title %>
</h1>
</header>
<section class="details" aria-label="Agreement details">
<div>
<span>Breeder / Seller</span>
<strong><%= contract.sellerName === undefined ? 'ImperialPaws Pekingese' : contract.sellerName %>
</strong>
</div>
<div>
<span>Adopting parent</span>
<strong><%= buyerName %>
</strong>
</div>
<div>
<span>Breed</span>
<strong><%= contract.breed === undefined ? 'Pekingese' : contract.breed %>
</strong>
</div>
<div>
<span>Agreement date</span>
<strong><%= new Date().toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'}) %>
</strong>
</div>
</section>
<div class="contract-body"><%= contract.filledBody %>
</div>
<section class="signature-block" aria-label="Signatures">
<div>
<strong>Breeder / Seller</strong><%= contract.sellerName === undefined ? 'ImperialPaws Pekingese' : contract.sellerName %>
<div class="signature">
</div>Signature<div class="date">Date: ____________________</div>
</div>
<div>
<strong>Adopting Parent</strong><%= buyerName %>
<div class="signature">
</div>Signature<div class="date">Date: ____________________</div>
</div>
</section>
<footer>
<span>Pet adoption agreement</span>
<span>Page 1 of 1</span>
</footer>
</div>
</article>
</div>
<script>
function fitPage() {
  const content = document.getElementById('content');
  const page = document.querySelector('.contract-page');
  const body = document.querySelector('.contract-body');
  content.style.transform = 'none';
  content.style.left = '0';
  let fontSize = 10.5;
  body.style.fontSize = fontSize + 'pt';
  while (content.scrollHeight > page.clientHeight - 2 && fontSize > 8) {
    fontSize -= .25;
    body.style.fontSize = fontSize + 'pt';
  }
  const scale = Math.min(1, (page.clientHeight - 2) / content.scrollHeight);
  content.style.transform = 'scale(' + scale + ')';
  content.style.left = (page.clientWidth * (1 - scale) / 2) + 'px';
  document.getElementById('fitStatus').textContent = scale < .9
    ? 'Fits one page. Text is reduced; shorten the agreement for easier reading. Print on Letter paper with browser headers and footers off.'
    : 'One-page Letter agreement. Turn off browser headers and footers when printing.';
}
document.getElementById('printButton').addEventListener('click',()=>{fitPage();window.print()});window.addEventListener('beforeprint',fitPage);window.addEventListener('load',fitPage);document.fonts.ready.then(fitPage);
</script>
</body>
</html>
