<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Preview & send · ImperialPaws</title><link rel="stylesheet" href="/css/invoice.css"><style>
body{background:#f3f0e9;color:#293b31;font:16px Arial,sans-serif}.composer{max-width:900px;margin:32px auto;padding:24px;background:#fffdf8;border:1px solid #e6dfd1;border-radius:16px}h1{font-family:Georgia,serif}label{display:block;margin:20px 0 8px;font-weight:bold}input,select,textarea{box-sizing:border-box;width:100%;padding:12px;border:1px solid #cfc7b6;border-radius:6px;font:inherit}button,.action{display:inline-block;padding:12px 18px;margin:12px 8px 0 0;border:0;border-radius:6px;background:#263e31;color:white;font:inherit;text-decoration:none;cursor:pointer}iframe{width:100%;height:760px;border:1px solid #e6dfd1;background:white}.notice{padding:14px;background:#f3eee3}.error{color:#942525}a{color:#31543d}@media(max-width:600px){.composer{margin:12px;padding:16px}iframe{height:850px}}
</style></head><body><main class="composer"><a href="/admin/invoices/view/<%= encodeURIComponent(invoice.invoiceNumber) %>">← Back to invoice</a><h1>🐾 Preview &amp; send</h1><p>Invoice <strong><%= invoice.invoiceNumber %></strong> · <%= invoice.adoptingParent?.name %></p>
<% if (error) { %><p class="notice error" role="alert"><%= error %></p><% } %>
<% if (!draft) { const v = values || {}; %>
<p class="notice">Saving an invoice or recording payment does not send an email. Review your message here, then send it yourself.</p>
<form method="post" action="/admin/invoices/<%= encodeURIComponent(invoice.invoiceNumber) %>/email/preview">
<label for="kind">Document</label><select id="kind" name="kind"><option value="invoice" <%= v.kind === "invoice" ? "selected" : "" %>>Adoption invoice</option><% if(invoice.paid) { %><option value="receipt" <%= v.kind === "receipt" ? "selected" : "" %>>Payment receipt (paid in full)</option><% } %></select>
<% if(!invoice.paid) { %><p>To issue a receipt, first record the received payment using “Mark paid”.</p><% } %>
<label for="mode">How should it arrive?</label><select id="mode" name="mode"><option value="email" <%= v.mode === 'email' ? 'selected' : '' %>>Direct email — full document in the email, no PDF or download link</option><option value="pdf" <%= v.mode === 'pdf' ? 'selected' : '' %>>PDF attachment — short email with the document attached</option><option value="both" <%= v.mode === 'both' ? 'selected' : '' %>>Both — full email document and PDF attachment</option></select>
<label for="to">Recipient</label><input type="email" id="to" name="to" required value="<%= v.to ?? invoice.adoptingParent?.email ?? '' %>">
<label for="subject">Subject</label><input id="subject" name="subject" required maxlength="160" value="<%= v.subject ?? ("Your adoption document · " + invoice.invoiceNumber) %>">
<label for="message">Personal message</label><textarea id="message" name="message" rows="5" maxlength="5000"><%= v.message ?? ('Thank you for choosing ' + (invoice.seller?.name || 'ImperialPaws') + '. Please review your adoption document. You can reply directly to this email with any questions.') %></textarea>
<button type="submit">Preview before sending</button></form>
<% } else { %>
<p><strong>To:</strong> <%= draft.mail.to %><br><strong>Subject:</strong> <%= draft.mail.subject %><br><strong>Format:</strong> <%= {email:'Direct email',pdf:'PDF attachment',both:'Email and PDF'}[draft.options.mode] %></p>
<p class="notice">Nothing has been sent. This preview expires in 15 minutes. Review the email<%= draft.pdf ? ' and attached PDF' : '' %> before sending.</p>
<iframe title="Buyer email preview" sandbox="allow-same-origin" onload="this.style.height = Math.max(450, this.contentDocument.documentElement.scrollHeight + 24) + 'px'" srcdoc="<%= draft.mail.html %>"></iframe>
<% if(draft.pdf) { %><p><a class="action" target="_blank" rel="noopener" href="/admin/invoices/<%= encodeURIComponent(invoice.invoiceNumber) %>/email/preview.pdf">Open exact PDF attachment</a></p><% } %>
<form method="post" action="/admin/invoices/<%= encodeURIComponent(invoice.invoiceNumber) %>/email/send" onsubmit="this.querySelector('button').disabled=true"><input type="hidden" name="token" value="<%= draft.token %>"><button type="submit">Send <%= draft.options.kind %> to buyer</button><a href="/admin/invoices/<%= encodeURIComponent(invoice.invoiceNumber) %>/email">Edit message or format</a></form>
<% } %></main><script>window.addEventListener("resize", () => { const frame = document.querySelector("iframe"); if(frame && frame.contentDocument) { frame.style.height = "450px"; frame.style.height = Math.max(450, frame.contentDocument.documentElement.scrollHeight + 24) + "px"; } });</script></body></html>
