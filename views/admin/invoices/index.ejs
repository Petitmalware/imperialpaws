<div class="admin-shell">
  <%- include("../../partials/admin-sidebar", { active: "invoices" }) %>

  <main class="admin-content">
    <header class="admin-page-header">
      <div>
        <p class="admin-eyebrow">Payments</p>
        <h1>Adoption Invoices</h1>
        <p class="admin-subtitle">Create adoption invoices, track payment status, and communicate with buyers.</p>
      </div>
      <a href="/admin/invoices/select-application" class="admin-link-button">Create Invoice</a>
    </header>

    <% if (success) { %>
      <div style="background:#F0FDF4; border:1px solid #22C55E; color:#166534; padding:1rem; border-radius:8px; margin-bottom:1.5rem; font-weight:600;">
        ✅ <%= success %>
      </div>
    <% } %>

    <% if (error) { %>
      <div style="background:#FEF2F2; border:1px solid #EF4444; color:#991B1B; padding:1rem; border-radius:8px; margin-bottom:1.5rem; font-weight:600;">
        ❌ <%= error %>
      </div>
    <% } %>

    <% if (!invoices.length) { %>
      <section class="admin-empty-state">
        <strong>No invoices created yet.</strong>
        <p class="admin-muted">Approve an application, then create the buyer invoice from this section.</p>
      </section>
    <% } else { %>
      <div class="admin-toolbar"><div class="admin-search"><label for="invoice-table-search">Find an invoice</label><input type="search" id="invoice-table-search" placeholder="Invoice number, buyer, or status" data-table-search="invoice-table" data-search-count="invoice-table-count" data-search-empty="invoice-table-empty"></div><span class="admin-muted" id="invoice-table-count" aria-live="polite"></span></div><p id="invoice-table-empty" class="admin-empty-state" hidden>No matching records. Try another search.</p>
      <div class="admin-table-wrap">
        <table class="admin-table" id="invoice-table">
          <thead>
            <tr>
              <th>Invoice</th>
              <th>Buyer</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% invoices.forEach(inv => { %>
              <%
                const buyerEmail = inv.adoptingParent && inv.adoptingParent.email;
                const buyerName = (inv.adoptingParent && inv.adoptingParent.name) || "there";
              %>
              <tr>
                <td><strong><%= inv.invoiceNumber %></strong></td>
                <td>
                  <%= buyerName === "there" ? "Unknown" : buyerName %>
                  <% if (buyerEmail) { %><br><small><%= buyerEmail %></small><% } %>
                </td>
                <td>
                  <span class="status-badge <%= inv.paid ? 'paid' : 'pending' %>">
                    <%= inv.paid ? "Paid" : "Pending" %>
                  </span>
                </td>
                <td><%= inv.createdAt ? new Date(inv.createdAt).toLocaleDateString() : "Unknown" %></td>
                <td class="admin-actions" style="display:flex; flex-wrap:wrap; gap:0.4rem; align-items:flex-start;">

                  <a class="btn-small" href="/admin/invoices/view/<%= inv.invoiceNumber %>">View</a>
                  <a class="btn-small" href="/admin/invoices/edit/<%= inv.invoiceNumber %>">Edit</a>

                  <form data-submit-lock method="POST" action="/admin/invoices/<%= inv.invoiceNumber %>/toggle-paid">
                    <button type="submit" class="btn-small">
                      <%= inv.paid ? "Mark Unpaid" : "Mark paid & email receipt" %>
                    </button>
                  </form>

                  <% if (buyerEmail && !inv.paid) { %>
                    <form data-submit-lock method="POST" action="/admin/invoices/<%= inv.invoiceNumber %>/send-reminder">
                      <button type="submit" class="btn-small" style="background:#FEF3C7; color:#92400E; border:1px solid #F59E0B;">
                        🔔 Send Reminder
                      </button>
                    </form>
                  <% } %>

                  <% if (buyerEmail) { %><form data-submit-lock method="POST" action="/admin/invoices/<%= encodeURIComponent(inv.invoiceNumber) %>/send-pdf"><button type="submit" class="btn-small">Email invoice PDF</button></form>
                    <button
                      class="btn-small"
                      style="background:#EFF6FF; color:#1E40AF; border:1px solid #93C5FD;"
                      data-number="<%= inv.invoiceNumber %>" data-email="<%= buyerEmail %>" data-name="<%= buyerName %>" onclick="openReply(this.dataset.number, this.dataset.email, this.dataset.name)"
                    >
                      ✉️ Manual Reply
                    </button>
                  <% } %>

                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</div>

<dialog id="replyModal" class="admin-dialog" aria-labelledby="reply-title">
  <div class="admin-section-title"><h2 id="reply-title">A message to your adopter</h2><button type="button" class="btn-small" onclick="closeReply()" aria-label="Close message">Close</button></div>
  <p class="admin-muted" id="replyToDisplay"></p>
  <form method="POST" id="replyForm" class="admin-form" data-submit-lock>
    <input type="hidden" name="toEmail" id="replyToEmail"><input type="hidden" name="toName" id="replyToName">
    <div class="form-group"><label for="invoice-reply-subject">Subject</label><input id="invoice-reply-subject" name="subject" required maxlength="160" placeholder="Your puppy adoption invoice"></div>
    <div class="form-group"><label for="invoice-reply-body">Your message</label><textarea id="invoice-reply-body" name="messageBody" rows="7" maxlength="5000" required placeholder="Write a personal message…"></textarea></div>
    <p class="admin-muted">This message will be emailed to the buyer shown above.</p>
    <div class="admin-actions"><button type="submit" class="btn-primary">Send email</button><button type="button" class="btn-secondary" onclick="closeReply()">Cancel</button></div>
  </form>
</dialog>
<script>
function openReply(invoiceNumber, email, name) {
  document.getElementById('replyToEmail').value = email;
  document.getElementById('replyToName').value = name;
  document.getElementById('replyToDisplay').textContent = 'To: ' + name + ' <' + email + '>';
  document.getElementById('replyForm').action = '/admin/invoices/' + encodeURIComponent(invoiceNumber) + '/manual-reply';
  document.getElementById('replyModal').showModal();
}
function closeReply() { document.getElementById('replyModal').close(); }
</script>
