<section class="page-content confirmation-page"><div class="container narrow">
  <div class="confirmation-card">
    <div class="success-mark" aria-hidden="true">✓</div><p class="eyebrow">Your adoption journey</p><h1><%= existingApplication ? 'You’re already on our list.' : 'Application received.' %></h1>
    <p><%= existingApplication ? 'We found your original application for this puppy. Use the same private code to follow its progress.' : 'Thank you for telling us about your home. We’ll review your application and may contact you for more information.' %></p>
    <div class="tracking-code-card"><span>Your private tracking code</span><strong id="application-code"><%= trackingCode %></strong><button type="button" class="copy-button" data-copy-target="application-code" hidden>Copy code</button><small data-copy-feedback aria-live="polite"></small></div>
    <p class="note">Save this code somewhere safe. It gives access to your status and approved invoice.</p>
    <div class="action-row"><a href="/track/result?code=<%= encodeURIComponent(trackingCode) %>" class="btn-primary">View my application ↗</a><a href="/contact" class="btn-secondary">Ask a question</a></div>
  </div>
</div></section>
