<section class="page-hero"><div class="container"><p class="eyebrow">Your adoption journey, in one place</p><h1>Welcome back.</h1><p class="subtitle">Use your private tracking code to see your application status and approved invoice.</p></div></section>
<section class="page-content"><div class="container track-layout">
  <div class="track-entry">
    <% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
    <form method="GET" action="/track/result" class="track-form">
      <% const trackingCode = typeof code !== 'undefined' ? code : ''; %>
      <h2>Find your application</h2><div class="form-group"><label for="tracking-code">Tracking code</label><input id="tracking-code" type="text" name="code" value="<%= trackingCode %>" required autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="tracking-help"><small id="tracking-help">Enter the code shown after you applied. Check your confirmation email too, if one was sent.</small></div>
      <button class="btn-primary" type="submit">View application <span aria-hidden="true">↗</span></button>
    </form>
  </div>
  <aside class="next-steps-card"><%- include('../partials/paw-logo') %><h2>A little help along the way.</h2><p>Can’t find your code? Contact us with the email address you used and the puppy’s name.</p><a href="/contact" class="text-link">Get help with my application ↗</a><hr><p><strong>Your code is private.</strong><br>Keep it safe and share it only with people you trust.</p></aside>
</div></section>
