<section class="welcome-hero">
  <div class="container welcome-grid">
    <div class="welcome-copy">
      <p class="eyebrow"><span aria-hidden="true">✦</span> A little paw. A lifelong companion.</p>
      <h1>A new chapter.<br>A little more <em>love.</em></h1>
      <p>Meet our puppies, get to know their stories, and take the next step toward welcoming a companion home.</p>
      <div class="action-row"><a class="btn-primary" href="/puppies">Meet the puppies <span aria-hidden="true">↗</span></a><a class="btn-secondary" href="/adoption-process">How adoption works</a></div>
      <div class="hero-footnote"><%- include('../partials/paw-logo') %><span>Thoughtful placement.<br><strong>Every family starts with an application.</strong></span></div>
    </div>
    <div class="welcome-photo">
      <img src="/images/hero-pekingese.jpg" alt="A Pekingese puppy" width="700" height="780" fetchpriority="high" decoding="async">
      <div class="photo-caption"><span class="caption-paw" aria-hidden="true">🐾</span><div><strong>Small paws, big personalities.</strong><span>Find out who is waiting to meet you.</span></div></div>
    </div>
  </div>
</section>
<section class="visitor-shortcuts" aria-label="Where would you like to go?">
  <div class="container shortcut-grid">
    <a href="/puppies"><span class="shortcut-number">01</span><span><strong>Find your companion</strong><small>Browse photos and puppy profiles</small></span><span aria-hidden="true">↗</span></a>
    <a href="/track"><span class="shortcut-number">02</span><span><strong>Already applied?</strong><small>Check your status and documents</small></span><span aria-hidden="true">↗</span></a>
    <a href="/contact"><span class="shortcut-number">03</span><span><strong>Let’s talk</strong><small>Get help with your next step</small></span><span aria-hidden="true">↗</span></a>
  </div>
</section>
<section class="home-featured-lux">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">Meet the little ones</p><h2>Big love starts here.</h2></div><a href="/puppies" class="text-link">Explore all puppies <span aria-hidden="true">↗</span></a></div>
    <% if (featuredPuppies && featuredPuppies.length) { %>
      <div class="featured-grid">
        <% featuredPuppies.forEach(puppy => { %>
          <article class="featured-card">
            <a href="/puppies/<%= puppy.id %>" class="featured-image" aria-label="Meet <%= puppy.name %>">
              <% if (puppy.images && puppy.images.length) { %>
                <img src="<%= puppy.images.find(i => i.isCover)?.path || puppy.images[0].path %>" alt="<%= puppy.name %>" loading="lazy" decoding="async">
              <% } else { %><div class="image-placeholder"><span aria-hidden="true">🐾</span> Photos coming soon</div><% } %>
              <span class="featured-status <%= statusClass(puppy.status) %>"><%= puppy.status || 'Available' %></span>
            </a>
            <div class="featured-body">
              <p class="eyebrow"><%= puppy.breed || 'Pekingese' %></p><h3><%= puppy.name %></h3>
              <p class="meta"><%= [puppy.gender, puppy.color].filter(Boolean).join(' · ') %></p>
              <div class="puppy-card-footer"><% if (puppy.price) { %><span class="price"><small>Adoption fee</small><%= currencySymbol(puppy.currency) %><%= Number(puppy.price).toFixed(2) %></span><% } %><a href="/puppies/<%= puppy.id %>" class="text-link">Meet <%= puppy.name %> ↗</a></div>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state"><%- include('../partials/paw-logo') %><h3>Good things are worth waiting for.</h3><p>No featured puppies are listed right now. Browse current listings or get in touch about availability.</p><a class="btn-secondary" href="/puppies">View puppy listings</a></div>
    <% } %>
  </div>
</section>
<section class="journey-section">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">A thoughtful beginning</p><h2>From first hello to next steps.</h2></div><p>A clear path, with room for questions along the way.</p></div>
    <div class="journey-grid">
      <article><span class="journey-number">01</span><h3>Get to know a puppy</h3><p>Explore photos, personality notes, health details, and current availability.</p><a href="/puppies" class="text-link">Browse puppies ↗</a></article>
      <article><span class="journey-number">02</span><h3>Tell us about your home</h3><p>Complete a short application from the puppy’s profile. No payment is requested when you apply.</p><a href="/adoption-process" class="text-link">See the process ↗</a></article>
      <article><span class="journey-number">03</span><h3>Follow your next steps</h3><p>Save your private tracking code to check your application status and approved invoice.</p><a href="/track" class="text-link">My application ↗</a></article>
    </div>
  </div>
</section>
<% if (testimonials && testimonials.length) { %>
<section class="home-testimonials-lux">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">Letters from our families</p><h2>Little paws. Lasting stories.</h2></div><a href="/testimonials" class="text-link">Read family stories ↗</a></div>
    <div class="testimonials-grid">
      <% testimonials.slice(0, 3).forEach(t => { %>
        <article class="testimonial-card"><span class="quote-mark" aria-hidden="true">“</span><p class="testimonial-message"><%= t.message %></p><div class="testimonial-author"><strong><%= t.name %></strong><% if (t.location) { %><span><%= t.location %></span><% } %></div></article>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
<section class="welcome-help"><div class="container"><div><p class="eyebrow">We’re here for your next chapter</p><h2>A few questions before you begin?</h2><p>Start with our FAQs, or reach out for help with a puppy or an existing application.</p></div><div class="action-row"><a class="btn-primary" href="/faq">Explore FAQs</a><a class="btn-secondary" href="/contact">Get in touch</a></div></div></section>
