<div class="help-page">
  <header class="help-intro"><p class="eyebrow">A little guidance</p><h1>Questions before the first hello?</h1><p>Find help with choosing a puppy, applying, and getting ready to welcome a new companion.</p></header>
  <div class="help-layout">
    <aside class="help-aside"><nav class="help-category-nav" aria-label="Question topics"><% faqGroups.forEach(group => { %><a href="#<%= group.id %>"><%= group.title %></a><% }) %></nav><h2>Let’s talk.</h2><p>Have a question about your own situation? We’re happy to hear from you.</p><a class="text-link" href="/contact">Get in touch <span aria-hidden="true">↗</span></a></aside>
    <div><% faqGroups.forEach(group => { %><section class="help-faq-group" id="<%= group.id %>" aria-labelledby="<%= group.id %>-heading"><h2 id="<%= group.id %>-heading"><%= group.title %></h2><% group.items.forEach(item => { %><details><summary><%= item.question %></summary><div class="help-answer"><p><%= item.answer %></p><% if (item.link) { %><a class="text-link" href="<%= item.link.href %>"><%= item.link.label %> <span aria-hidden="true">↗</span></a><% } %></div></details><% }) %></section><% }) %></div>
  </div>
</div>
