<% const contact = siteSettings.contact || {}; %>
<section class="page-hero"><div class="container"><p class="eyebrow">A conversation starts here</p><h1>How can we help?</h1><p class="subtitle">Questions about a puppy, an application, or the next step? Let’s point you in the right direction.</p></div></section>
<section class="page-content"><div class="container">
  <div class="contact-route-grid"><a href="/puppies" class="contact-route"><span class="step-tag">01</span><h2>Meet a puppy</h2><p>See current availability, explore a profile, and apply from the puppy’s page.</p><strong>Browse puppies ↗</strong></a><a href="/track" class="contact-route"><span class="step-tag">02</span><h2>Check an application</h2><p>Your private code takes you to your status and approved invoice.</p><strong>Track my application ↗</strong></a><a href="/faq" class="contact-route"><span class="step-tag">03</span><h2>Have a quick question?</h2><p>Read about applications, puppy care, and the adoption process.</p><strong>Explore FAQs ↗</strong></a></div>
  <div class="contact-main"><div><p class="eyebrow">Reach out</p><h2>We’re here for the next step.</h2><p>If you’ve already applied, mention your name and the puppy you applied for. Please keep payment and identification details out of your message.</p></div><div class="contact-methods">
    <% if (contact.email) { %><a href="mailto:<%= contact.email %>"><span>Email us</span><strong><%= contact.email %></strong><small>Open your email app ↗</small></a><% } %>
    <% if (contact.phone) { %><a href="tel:<%= contact.phone.replace(/[^0-9+]/g, '') %>"><span>Call us</span><strong><%= contact.phone %></strong><small>Open your phone app ↗</small></a><% } %>
    <% if (contact.location) { %><div><span>Our location</span><strong><%= contact.location %></strong></div><% } %>
    <% if (!contact.email && !contact.phone && !contact.location) { %><p>Public contact details haven’t been posted yet. Existing applicants can reply to the email they received from the breeder.</p><% } %>
  </div></div>
</div></section>
