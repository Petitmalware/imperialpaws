<%
  /* ─── Computed helpers ───────────────────────────────────────────── */
  const invoiceItems  = (invoice && invoice.items) ? invoice.items : [];
  const invoiceTotal  = invoiceItems.reduce(function(sum, item) {
    return sum + Number(item.qty || 0) * Number(item.unitPrice || 0);
  }, 0);
  const invoiceCurrency = (invoice && invoice.currency) ? invoice.currency : '$';

  const st = String(application.status || '').trim();

  /* Step completion logic */
  const step1Done = true;
  const step2Done = ['Approved', 'Sold'].includes(st);
  const step3Done = ['Approved', 'Sold'].includes(st);
  const step4Done = !!invoice;
  const step5Done = !!(invoice && invoice.paid);
  const step6Done = st === 'Sold';
  const step7Done = false;

  /* Determine active step */
  let activeStep = 1;
  if (st === 'Pending')               activeStep = 2;
  if (step2Done && !step4Done)        activeStep = 4;
  if (step4Done && !step5Done)        activeStep = 5;
  if (step5Done && !step6Done)        activeStep = 6;
  if (step6Done)                      activeStep = 7;

  function stepState(n) {
    if (n === 1 && step1Done) return 'done';
    if (n === 2 && step2Done) return 'done';
    if (n === 3 && step3Done) return 'done';
    if (n === 4 && step4Done) return 'done';
    if (n === 5 && step5Done) return 'done';
    if (n === 6 && step6Done) return 'done';
    if (n === activeStep)     return 'active';
    return 'upcoming';
  }

  const steps = [
    { n: 1, label: 'Application\nSubmitted'  },
    { n: 2, label: 'Under\nReview'           },
    { n: 3, label: 'Application\nApproved'   },
    { n: 4, label: 'Invoice\nIssued'         },
    { n: 5, label: 'Payment\nReceived'       },
    { n: 6, label: 'Puppy\nReserved'         },
    { n: 7, label: 'Pickup /\nDelivery'      }
  ];

  /* What Happens Next copy */
  let nextTip = '';
  if (st === 'Pending') {
    nextTip = 'Your application is being reviewed. You will receive an email within 24\u201348 hours.';
  } else if (st === 'Approved' && !invoice) {
    nextTip = 'Your application is approved! Your invoice is being prepared and will be emailed to you shortly.';
  } else if (st === 'Approved' && invoice && !invoice.paid) {
    nextTip = 'Your invoice is ready. Reply to your email or contact <a href="mailto:info@imperialpaws.pet" style="color:#C7A45A;">info@imperialpaws.pet</a> to arrange payment.';
  } else if (st === 'Sold') {
    nextTip = 'Your puppy is fully reserved! Our team will reach out shortly to arrange pickup or delivery.';
  }

  /* Puppy photo */
  const puppyPhoto = (puppy && puppy.images && puppy.images.length)
    ? (puppy.images.find(function(i){ return i.isCover; }) || puppy.images[0]).path
    : null;
%>

<style>
  /* ── Base ───────────────────────────────────────────────── */
  .tr-page { background:#FBF9F5; color:#333; font-family:'Georgia',serif; }

  /* ── Hero ───────────────────────────────────────────────── */
  .tr-hero {
    background:#1A1916;
    color:#FBF9F5;
    padding:56px 20px 40px;
    text-align:center;
  }
  .tr-hero h1 {
    font-size:clamp(1.6rem,4vw,2.4rem);
    font-weight:700;
    letter-spacing:.04em;
    margin:0 0 12px;
    color:#FBF9F5;
  }
  .tr-hero-sub {
    font-size:.95rem;
    color:#C7A45A;
    letter-spacing:.08em;
    text-transform:uppercase;
    margin:0 0 20px;
  }
  .tr-applicant-name {
    font-size:1.1rem;
    color:#d9cdb4;
    margin:0 0 18px;
  }
  .tr-code-wrap {
    display:inline-flex;
    align-items:center;
    gap:10px;
    background:rgba(255,255,255,.06);
    border:1px solid rgba(199,164,90,.35);
    border-radius:8px;
    padding:10px 18px;
    margin-bottom:20px;
  }
  .tr-code-label {
    font-size:.75rem;
    color:#a09070;
    text-transform:uppercase;
    letter-spacing:.1em;
  }
  .tr-code-value {
    font-family:'Courier New',monospace;
    font-size:1rem;
    color:#C7A45A;
    letter-spacing:.12em;
  }
  .tr-date-chip {
    font-size:.78rem;
    color:#999;
    margin-top:10px;
    letter-spacing:.04em;
  }

  /* ── Status pill ─────────────────────────────────────────── */
  .tr-pill {
    display:inline-block;
    padding:5px 16px;
    border-radius:999px;
    font-size:.8rem;
    font-weight:600;
    letter-spacing:.08em;
    text-transform:uppercase;
  }
  .tr-pill.pending  { background:#f0e6cc; color:#8a6520; }
  .tr-pill.approved { background:#d4edda; color:#1d6b38; }
  .tr-pill.sold     { background:#C7A45A; color:#1A1916; }
  .tr-pill.draft,
  .tr-pill.unknown  { background:#e9e9e9; color:#666; }

  /* ── Section wrapper ─────────────────────────────────────── */
  .tr-body {
    max-width:820px;
    margin:0 auto;
    padding:40px 20px 60px;
  }
  .tr-section {
    background:#fff;
    border:1px solid #e8e0d0;
    border-radius:12px;
    padding:32px;
    margin-bottom:28px;
    box-shadow:0 2px 12px rgba(26,25,22,.05);
  }
  .tr-section-title {
    font-size:1rem;
    font-weight:700;
    letter-spacing:.07em;
    text-transform:uppercase;
    color:#1A1916;
    margin:0 0 24px;
    padding-bottom:12px;
    border-bottom:1px solid #e8e0d0;
  }

  /* ── Timeline ────────────────────────────────────────────── */
  .tr-timeline {
    display:flex;
    align-items:flex-start;
    gap:0;
    position:relative;
    overflow-x:auto;
    padding-bottom:4px;
  }
  .tr-step {
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:center;
    position:relative;
    min-width:80px;
  }
  .tr-step-connector {
    position:absolute;
    top:20px;
    left:50%;
    width:100%;
    height:2px;
    background:#ddd;
    z-index:0;
  }
  .tr-step-connector.done   { background:#C7A45A; }
  .tr-step-connector.active { background:linear-gradient(90deg,#C7A45A 50%,#ddd 50%); }
  .tr-step:last-child .tr-step-connector { display:none; }

  .tr-circle {
    width:40px;
    height:40px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:.85rem;
    font-weight:700;
    position:relative;
    z-index:1;
    flex-shrink:0;
    transition:transform .2s;
  }
  .tr-circle.done {
    background:#C7A45A;
    color:#1A1916;
    border:2px solid #C7A45A;
  }
  .tr-circle.active {
    background:#a07c38;
    color:#fff;
    border:2px solid #a07c38;
    animation:tr-pulse 1.6s ease-in-out infinite;
  }
  .tr-circle.upcoming {
    background:#f2efea;
    color:#aaa;
    border:2px solid #ddd;
  }
  @keyframes tr-pulse {
    0%,100% { box-shadow:0 0 0 0 rgba(199,164,90,.55); }
    50%      { box-shadow:0 0 0 8px rgba(199,164,90,0); }
  }
  .tr-step-label {
    margin-top:10px;
    font-size:.7rem;
    text-align:center;
    color:#555;
    white-space:pre-line;
    line-height:1.4;
    max-width:76px;
  }
  .tr-step-label.active { color:#a07c38; font-weight:700; }
  .tr-step-label.done   { color:#7a5e1e; }

  @media(max-width:600px) {
    .tr-timeline {
      flex-direction:column;
      align-items:flex-start;
      overflow-x:visible;
    }
    .tr-step {
      flex-direction:row;
      align-items:flex-start;
      min-width:unset;
      width:100%;
      gap:16px;
      padding-bottom:12px;
    }
    .tr-step-connector {
      top:0;
      left:19px;
      width:2px;
      height:calc(100% + 12px);
      transform:none;
    }
    .tr-step-label {
      margin-top:8px;
      text-align:left;
      white-space:normal;
      max-width:none;
    }
  }

  /* ── Puppy card ──────────────────────────────────────────── */
  .tr-puppy-inner {
    display:flex;
    gap:28px;
    align-items:flex-start;
  }
  @media(max-width:540px) {
    .tr-puppy-inner { flex-direction:column; align-items:center; }
  }
  .tr-puppy-photo {
    width:160px;
    height:160px;
    border-radius:12px;
    object-fit:cover;
    border:3px solid #e8e0d0;
    flex-shrink:0;
  }
  .tr-puppy-placeholder {
    width:160px;
    height:160px;
    border-radius:12px;
    background:#f2efea;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:3.5rem;
    border:3px solid #e8e0d0;
    flex-shrink:0;
  }
  .tr-puppy-info { flex:1; }
  .tr-puppy-breed {
    font-size:.75rem;
    text-transform:uppercase;
    letter-spacing:.1em;
    color:#C7A45A;
    font-weight:700;
    margin-bottom:4px;
  }
  .tr-puppy-name {
    font-size:1.5rem;
    font-weight:700;
    color:#1A1916;
    margin:0 0 10px;
  }
  .tr-puppy-meta {
    list-style:none;
    padding:0;
    margin:12px 0 16px;
    display:flex;
    flex-wrap:wrap;
    gap:8px 24px;
  }
  .tr-puppy-meta li { font-size:.88rem; color:#555; }
  .tr-puppy-meta li strong { color:#333; }
  .tr-puppy-price {
    font-size:1.4rem;
    font-weight:700;
    color:#1A1916;
    margin-bottom:16px;
  }
  .tr-btn {
    display:inline-block;
    padding:10px 22px;
    border-radius:8px;
    font-size:.85rem;
    font-weight:700;
    letter-spacing:.06em;
    text-decoration:none;
    cursor:pointer;
    transition:opacity .15s;
    border:none;
  }
  .tr-btn:hover { opacity:.85; }
  .tr-btn-gold    { background:#C7A45A; color:#1A1916; }
  .tr-btn-outline { background:transparent; border:2px solid #C7A45A; color:#C7A45A; }
  .tr-no-puppy {
    padding:24px;
    background:#faf8f4;
    border-radius:10px;
    color:#666;
    font-size:.9rem;
    line-height:1.6;
    text-align:center;
  }

  /* ── Invoice ─────────────────────────────────────────────── */
  .tr-inv-meta {
    display:flex;
    flex-wrap:wrap;
    gap:6px 32px;
    margin-bottom:20px;
  }
  .tr-inv-meta-item { font-size:.9rem; color:#555; }
  .tr-inv-meta-item strong { color:#333; }
  .tr-inv-badge {
    display:inline-block;
    padding:3px 12px;
    border-radius:999px;
    font-size:.75rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.08em;
    vertical-align:middle;
    margin-left:6px;
  }
  .tr-inv-badge.paid    { background:#d4edda; color:#1d6b38; }
  .tr-inv-badge.pending { background:#fff3cd; color:#7a5e00; }
  .tr-inv-total-label {
    font-size:.75rem;
    text-transform:uppercase;
    letter-spacing:.08em;
    color:#999;
    margin-bottom:2px;
  }
  .tr-inv-total {
    font-size:1.5rem;
    font-weight:700;
    color:#1A1916;
    margin:4px 0 20px;
  }
  .tr-callout {
    border-radius:10px;
    padding:18px 22px;
    margin-bottom:20px;
    font-size:.9rem;
    line-height:1.65;
  }
  .tr-callout-info {
    background:#FBF6EC;
    border-left:4px solid #C7A45A;
    color:#5a4720;
  }
  .tr-callout-success {
    background:#ecf7ef;
    border-left:4px solid #2e9e57;
    color:#1d5c33;
    display:flex;
    align-items:flex-start;
    gap:10px;
  }
  .tr-callout-success-icon { font-size:1.3rem; flex-shrink:0; margin-top:1px; }

  /* ── What happens next ───────────────────────────────────── */
  .tr-next-tip {
    background:#FBF9F5;
    border:1px solid #e8e0d0;
    border-radius:10px;
    padding:22px 26px;
    display:flex;
    gap:14px;
    align-items:flex-start;
    margin-bottom:28px;
  }
  .tr-next-icon { font-size:1.5rem; flex-shrink:0; line-height:1; margin-top:2px; }
  .tr-next-text { font-size:.92rem; line-height:1.7; color:#444; }
  .tr-next-text strong { color:#1A1916; display:block; margin-bottom:4px; font-size:.95rem; }

  /* ── Privacy notice ──────────────────────────────────────── */
  .tr-privacy {
    text-align:center;
    font-size:.78rem;
    color:#aaa;
    padding:16px 20px 0;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:7px;
  }
  .tr-privacy-icon { font-size:.95rem; color:#C7A45A; }
</style>

<div class="tr-page">

  <%# ══ SECTION 1 — Applicant & Status Header ══ %>
  <header class="tr-hero">
    <p class="tr-hero-sub">ImperialPaws Adoption Portal</p>
    <h1>Your Application Status</h1>
    <p class="tr-applicant-name">
      Welcome back, <strong><%= application.name %></strong>
    </p>
    <div class="tr-code-wrap">
      <span class="tr-code-label">Tracking Code</span>
      <span class="tr-code-value"><%= application.trackingCode || application.id %></span>
    </div>
    <br>
    <span class="tr-pill <%= statusClass(application.status) %>">
      <%= application.status %>
    </span>
    <p class="tr-date-chip">
      Application submitted on
      <%= new Date(application.createdAt).toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' }) %>
    </p>
  </header>

  <div class="tr-body">

    <%# ══ SECTION 2 — Adoption Journey Timeline ══ %>
    <div class="tr-section">
      <p class="tr-section-title">Your Adoption Journey</p>
      <div class="tr-timeline">
        <% steps.forEach(function(step, idx) {
             var state = stepState(step.n);
             var connState = (idx < steps.length - 1)
               ? (state === 'done' ? 'done' : (state === 'active' ? 'active' : ''))
               : '';
        %>
          <div class="tr-step">
            <% if (idx < steps.length - 1) { %>
              <div class="tr-step-connector <%= connState %>"></div>
            <% } %>
            <div class="tr-circle <%= state %>">
              <% if (state === 'done') { %>&#10003;<% } else { %><%= step.n %><% } %>
            </div>
            <span class="tr-step-label <%= state %>"><%= step.label %></span>
          </div>
        <% }); %>
      </div>
    </div>

    <%# ══ SECTION 3 — Puppy Info Card ══ %>
    <div class="tr-section">
      <p class="tr-section-title">Puppy Details</p>

      <% if (puppy) { %>
        <div class="tr-puppy-inner">

          <% if (puppyPhoto) { %>
            <img
              class="tr-puppy-photo"
              src="<%= puppyPhoto %>"
              alt="<%= puppy.name %>"
              loading="lazy"
              decoding="async">
          <% } else { %>
            <div class="tr-puppy-placeholder">&#128062;</div>
          <% } %>

          <div class="tr-puppy-info">
            <div class="tr-puppy-breed"><%= puppy.breed || 'Pekingese' %></div>
            <h2 class="tr-puppy-name"><%= puppy.name %></h2>
            <span class="tr-pill <%= statusClass(puppy.status) %>"><%= puppy.status || 'Available' %></span>

            <ul class="tr-puppy-meta">
              <% if (puppy.gender) { %>
                <li><strong>Gender:</strong> <%= puppy.gender %></li>
              <% } %>
              <% if (puppy.breed) { %>
                <li><strong>Breed:</strong> <%= puppy.breed %></li>
              <% } %>
            </ul>

            <% if (puppy.price) { %>
              <div class="tr-inv-total-label">Adoption Fee</div>
              <div class="tr-puppy-price">
                <%= currencySymbol(puppy.currency) %><%= Number(puppy.price).toFixed(2) %>
              </div>
            <% } %>

            <a
              href="/puppies/<%= puppy.id %>"
              class="tr-btn tr-btn-outline"
              aria-label="View full puppy profile for <%= puppy.name %>">
              View Full Puppy Profile &rarr;
            </a>
          </div>

        </div>
      <% } else { %>
        <div class="tr-no-puppy">
          <p>&#128062; The puppy profile linked to this application is not currently visible on the public site.</p>
          <p style="margin-top:8px;">Please contact us at
            <a href="mailto:info@imperialpaws.pet" style="color:#C7A45A;">info@imperialpaws.pet</a>
            for the latest details about your puppy.
          </p>
        </div>
      <% } %>
    </div>

    <%# ══ SECTION 4 — Invoice ══ %>
    <% if (['Approved', 'Sold'].includes(st) && invoice) { %>
      <div class="tr-section">
        <p class="tr-section-title">Invoice</p>

        <div class="tr-inv-meta">
          <div class="tr-inv-meta-item">
            <strong>Invoice No.</strong>&nbsp;<%= invoice.invoiceNumber %>
          </div>
          <div class="tr-inv-meta-item">
            <strong>Status</strong>
            <span class="tr-inv-badge <%= invoice.paid ? 'paid' : 'pending' %>">
              <%= invoice.paid ? 'Paid' : 'Pending' %>
            </span>
          </div>
          <% if (invoice.dueDate) { %>
            <div class="tr-inv-meta-item">
              <strong>Due Date</strong>&nbsp;<%= invoice.dueDate %>
            </div>
          <% } %>
          <% if (invoice.adoptingParent && invoice.adoptingParent.name) { %>
            <div class="tr-inv-meta-item">
              <strong>Billed To</strong>&nbsp;<%= invoice.adoptingParent.name %>
            </div>
          <% } %>
        </div>

        <div class="tr-inv-total-label">Invoice Total</div>
        <div class="tr-inv-total">
          <%= invoiceCurrency %><%= invoiceTotal.toFixed(2) %>
        </div>

        <% if (!invoice.paid) { %>
          <div class="tr-callout tr-callout-info">
            <strong style="display:block;margin-bottom:6px;color:#7a5e00;">How to arrange payment</strong>
            To arrange payment, simply reply to your approval email or contact us at
            <a href="mailto:info@imperialpaws.pet" style="color:#C7A45A;font-weight:600;">info@imperialpaws.pet</a>.
            Let us know what payment method you have available and we will send you our secure payment details privately.
          </div>
        <% } else { %>
          <div class="tr-callout tr-callout-success">
            <span class="tr-callout-success-icon">&#9989;</span>
            <div>
              <strong style="display:block;margin-bottom:4px;">Payment Confirmed</strong>
              Your puppy is reserved exclusively for you! Our team will be in touch shortly to arrange the next steps.
            </div>
          </div>
        <% } %>

        <a
          href="/invoice/<%= application.id %>/<%= invoice.invoiceNumber %>"
          class="tr-btn tr-btn-gold">
          View Full Invoice &rarr;
        </a>

      </div>
    <% } %>

    <%# ══ SECTION 5 — What Happens Next ══ %>
    <% if (nextTip) { %>
      <div class="tr-next-tip">
        <span class="tr-next-icon">
          <% if (st === 'Pending') { %>&#8987;<% } else if (st === 'Sold') { %>&#127881;<% } else { %>&#128203;<% } %>
        </span>
        <div class="tr-next-text">
          <strong>What Happens Next</strong>
          <%- nextTip %>
        </div>
      </div>
    <% } %>

    <%# ══ SECTION 6 — Privacy Notice ══ %>
    <p class="tr-privacy">
      <span class="tr-privacy-icon">&#128274;</span>
      Keep your tracking code private. This page is for the approved applicant only.
    </p>

  </div>
</div>
