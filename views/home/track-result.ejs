<%
  const state = String(application.status || 'Pending');
  const approved = ['Approved', 'Sold'].includes(state);
  const visibleInvoice = approved && invoice;
  const photo = puppy?.images?.find(i => i.isCover) || puppy?.images?.[0];
  const code = application.trackingCode || application.id;
  const subtotal = (invoice?.items || []).reduce((sum, item) => sum + Number(item.qty || 0) * Number(item.unitPrice || 0), 0);
  const total = subtotal + subtotal * Number(invoice?.taxRate || 0);
  const displayState = state === 'Sold' ? 'Completed' : state;
  const nextSteps = {
    Pending: 'Your application is waiting for review. We may contact you if we need a little more information.',
    Approved: visibleInvoice ? (invoice.paid ? 'Payment has been marked received. Please contact us to confirm the arrangements for your puppy.' : 'Your invoice is ready. Review the details and follow the instructions agreed with the breeder.') : 'Your application has been approved. Please watch for the next steps from the breeder.',
    Rejected: 'This application will not move forward. You can contact us if you have questions about the decision.',
    Sold: 'This placement has been marked complete in our records. Contact us if you need help with pickup, delivery, or your documents.'
  };
  const timeline = [
    { title: 'Application received', detail: 'Your information has been submitted.', done: true },
    { title: state === 'Rejected' ? 'Application reviewed' : 'Application review', detail: state === 'Pending' ? 'Waiting for review.' : state === 'Rejected' ? 'This application will not move forward.' : approved ? 'Your application is approved.' : 'See your current status above.', done: state !== 'Pending' },
    ...(state === 'Rejected' ? [] : [
      { title: 'Adoption invoice', detail: visibleInvoice ? 'Your invoice is available below.' : 'Issued after approval, when ready.', done: !!visibleInvoice },
      { title: 'Payment recorded', detail: visibleInvoice?.paid ? 'Payment marked received.' : 'Recorded by the breeder after confirmation.', done: !!visibleInvoice?.paid }
    ])
  ];
%>
<div class="application-portal">
  <section class="page-hero"><div class="container"><p class="eyebrow">Your adoption journey</p><h1>Hello, <%= application.name %>.</h1><p class="subtitle">Here’s where things stand with your application.</p><span class="portal-status <%= statusClass(state) %>"><%= displayState %></span></div></section>
  <section class="page-content"><div class="container portal-layout">
    <div>
      <div class="portal-card next-action"><p class="eyebrow">Your next step</p><h2><%= state === 'Pending' ? 'We have your application.' : state === 'Rejected' ? 'Your application has been reviewed.' : visibleInvoice && !invoice.paid ? 'Your invoice is ready.' : 'You’re up to date.' %></h2><p><%= nextSteps[state] || 'Contact us if you have questions about your application.' %></p><% if (visibleInvoice && !invoice.paid) { %><a class="btn-primary" href="/invoice/<%= encodeURIComponent(application.id) %>/<%= encodeURIComponent(invoice.invoiceNumber) %>">Review my invoice ↗</a><% } else { %><a href="/contact" class="text-link">Ask a question ↗</a><% } %></div>
      <div class="portal-card"><h2>Your progress</h2><ol class="application-timeline"><% timeline.forEach((step, index) => { %><li class="<%= step.done ? 'is-complete' : '' %>"><span class="timeline-marker" aria-hidden="true"><%= step.done ? '✓' : index + 1 %></span><div><strong><%= step.title %></strong><p><%= step.detail %></p></div></li><% }); %></ol></div>
      <% if (visibleInvoice) { %><div class="portal-card"><div class="section-heading"><div><p class="eyebrow">Your documents</p><h2>Adoption invoice</h2></div><span class="portal-status <%= invoice.paid ? 'approved' : 'pending' %>"><%= invoice.paid ? 'Paid' : 'Awaiting payment' %></span></div><dl class="portal-facts"><div><dt>Invoice number</dt><dd><%= invoice.invoiceNumber %></dd></div><div><dt>Total</dt><dd><%= (invoice.currency || '$') %><%= total.toFixed(2) %></dd></div><div><dt>Balance due</dt><dd><%= (invoice.currency || '$') %><%= (invoice.paid ? 0 : total).toFixed(2) %></dd></div><% if (invoice.dueDate) { %><div><dt>Due date</dt><dd><%= invoice.dueDate %></dd></div><% } %></dl><div class="action-row"><a class="btn-primary" href="/invoice/<%= encodeURIComponent(application.id) %>/<%= encodeURIComponent(invoice.invoiceNumber) %>/download">Download invoice PDF ↓</a><a class="btn-secondary" href="/invoice/<%= encodeURIComponent(application.id) %>/<%= encodeURIComponent(invoice.invoiceNumber) %>">View invoice</a></div></div><% } %>
    </div>
    <aside>
      <div class="application-puppy"><% if (puppy) { %><% if (photo) { %><img src="<%= photo.path %>" alt="<%= puppy.name %>" loading="lazy"><% } %><div><p class="eyebrow">Your puppy</p><h2><%= puppy.name %></h2><p><%= [puppy.breed || 'Pekingese', puppy.gender, puppy.color].filter(Boolean).join(' · ') %></p><a href="/puppies/<%= puppy.id %>" class="text-link">View puppy profile ↗</a></div><% } else { %><div><h2>Your puppy</h2><p>The profile is no longer available. Contact us for the latest details.</p><a href="/contact" class="text-link">Get in touch ↗</a></div><% } %></div>
      <div class="portal-card"><p class="eyebrow">Keep this somewhere safe</p><div class="tracking-code-card"><span>Private tracking code</span><strong id="application-code"><%= code %></strong><button type="button" class="copy-button" data-copy-target="application-code" hidden>Copy code</button><small data-copy-feedback aria-live="polite"></small></div><p class="small-note">This code gives access to your application. Keep it private.</p><% if (application.createdAt && !Number.isNaN(Date.parse(application.createdAt))) { %><p class="small-note">Applied <%= new Date(application.createdAt).toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' }) %></p><% } %></div>
    </aside>
  </div></section>
</div>
