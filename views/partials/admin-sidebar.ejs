<%
  const activeSection = typeof active !== "undefined" ? active : "";
  const admin = typeof adminUser !== "undefined" ? adminUser : null;
  const navGroups = [
    { label: "Your workspace", links: [
      ["dashboard", "Overview", "/admin/dashboard", "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"],
      ["applications", "Applications", "/admin/applications", "M8 3h8l4 4v14H4V3h4zm7 0v5h5M8 12h8M8 16h5"],
      ["puppies", "Puppies", "/admin/puppies", "M9 4 4 3 2 8l4 3v7l6 3 6-3v-7l4-3-2-5-5 1M9 13h.01M15 13h.01M10 17h4"]
    ] },
    { label: "Adoption & care", links: [
      ["reply-templates", "Email templates", "/admin/reply-templates", "M3 5h18v14H3V5zm0 0 9 8 9-8"],
      ["invoices", "Invoices", "/admin/invoices", "M5 3h14v18l-3-2-4 2-4-2-3 2V3zm4 5h6M9 12h6M9 16h3"],
      ["contracts", "Agreements", "/admin/contracts", "M14 3H5v18h14V8l-5-5zm0 0v5h5M8 12h8M8 16h5"],
      ["testimonials", "Family reviews", "/admin/testimonials", "m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3z"]
    ] },
    { label: "Manage", links: [
      ["settings", "Site settings", "/admin/settings", "M4 7h16M4 17h16M8 4v6M16 14v6"]
    ] }
  ];
  if (admin && admin.role === "owner") {
    navGroups[2].links.push(["admins", "Team access", "/admin/admins", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3a4 4 0 0 1 0 8M22 21v-2a4 4 0 0 0-3-3.9M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"]);
  }
%>
<a class="admin-skip-link" href="#admin-main-content">Skip to content</a>
<aside class="admin-sidebar" data-admin-sidebar>
  <div class="admin-sidebar-top">
    <a class="admin-logo" href="/admin/dashboard" aria-label="ImperialPaws overview">
      <span class="admin-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor"><ellipse cx="7" cy="12" rx="3.2" ry="4.2" transform="rotate(-28 7 12)"/><ellipse cx="13" cy="7" rx="3.1" ry="4.2" transform="rotate(-12 13 7)"/><ellipse cx="20" cy="7" rx="3.1" ry="4.2" transform="rotate(12 20 7)"/><ellipse cx="26" cy="12" rx="3.2" ry="4.2" transform="rotate(28 26 12)"/><path d="M8 23c0-4 5-10 8-10s8 6 8 10c0 7-5 4-8 4s-8 3-8-4z"/></svg>
      </span>
      <span><strong>ImperialPaws</strong><em>Breeder workspace</em></span>
    </a>
    <button class="admin-menu-toggle" type="button" aria-controls="admin-navigation" aria-expanded="false" data-admin-menu-toggle hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <span>Menu</span>
    </button>
  </div>
  <div class="admin-sidebar-content" id="admin-navigation">
    <nav class="admin-menu" aria-label="Admin navigation">
      <% navGroups.forEach(group => { %>
        <div class="admin-nav-group">
          <p class="admin-nav-label"><%= group.label %></p>
          <% group.links.forEach(([key, label, href, icon]) => { %>
            <a href="<%= href %>" class="<%= activeSection === key ? 'active' : '' %>" <%- activeSection === key ? 'aria-current="page"' : '' %>>
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icon %>"/></svg>
              <span><%= label %></span>
              <% if (activeSection === key) { %><span class="admin-nav-dot" aria-hidden="true"></span><% } %>
            </a>
          <% }) %>
        </div>
      <% }) %>
    </nav>
    <div class="admin-sidebar-footer">
      <a href="/" class="admin-visit-site" target="_blank" rel="noopener"><span>View your website</span><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 3h7v7M21 3 10 14M10 3H3v18h18v-7"/></svg></a>
      <% if (admin) { %>
        <div class="admin-user"><span class="admin-avatar" aria-hidden="true"><%= (admin.username || "B").slice(0, 1).toUpperCase() %></span><div><strong><%= admin.username %></strong><small><%= admin.role === "owner" ? "Workspace owner" : "Team member" %></small></div><a href="/admin/logout" class="admin-logout-link">Sign out</a></div>
      <% } else { %><a href="/admin/logout" class="admin-logout-link">Sign out</a><% } %>
    </div>
  </div>
</aside>
<script src="/js/admin.js" defer></script>
